{
  "name": "html2pdf-kami",
  "version": "1.0.0",
  "description": "HTML to PDF converter with GUI - maximum CSS fidelity",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.kami.html2pdf",
    "productName": "html2pdf-kami",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "converter.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "html2pdf-kami.exe"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "author": "kamilee1986",
  "license": "MIT"
}
